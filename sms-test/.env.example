# Copy this file to .env (same folder) and fill in your keys. .env is never committed.

# SMSEthiopia: Dashboard → API KEY → create a key (it sends through your campaign; the free one is "Default | 8726").
SMSETHIOPIA_KEY=

# AfroMessage: your team's dashboard → API / developer settings → token.
AFROMESSAGE_TOKEN=
# Optional — leave empty to use AfroMessage's defaults:
AFROMESSAGE_FROM=
AFROMESSAGE_SENDER=

# Your test phones (used by "--to ethio" and "--to safaricom", so the numbers stay out of commands and logs).
# Verify each one in both dashboards first — free accounts only send to verified numbers.
TEST_ETHIO_NUMBER=
TEST_SAFARICOM_NUMBER=
